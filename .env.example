#--------------------------------------------------------------------
# WERN backend - environment template.
# Copy this to `.env` and fill in real values. NEVER commit the real .env.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

app.baseURL = 'https://www.wernapp.com/'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = your_db_name
database.default.username = your_db_user
database.default.password = your_db_password
database.default.DBDriver = MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# JWT (auth token signing secret) - generate a long random value
#--------------------------------------------------------------------
jwt.secret = 'CHANGE_ME_TO_A_LONG_RANDOM_SECRET'

#--------------------------------------------------------------------
# TWILIO
#--------------------------------------------------------------------
TWILIO_SID   = 'your_twilio_sid'
TWILIO_TOKEN = 'your_twilio_token'
TWILIO_PHONE = '+1xxxxxxxxxx'

#--------------------------------------------------------------------
# MAILGUN (email / OTP delivery) - https://app.mailgun.com/
#--------------------------------------------------------------------
mailgun.apiKey       = 'your_mailgun_api_key'
mailgun.domain       = 'your_mailgun_domain'
mailgun.endpoint     = 'https://api.mailgun.net'
mailgun.from         = 'WERN App <noreply@your_domain>'
mailgun.forgotApiKey = 'your_forgot_password_key'
mailgun.signupApiKey = 'your_signup_key'

#--------------------------------------------------------------------
# FCM (Firebase Cloud Messaging - push notifications)
#--------------------------------------------------------------------
fcm.projectId          = 'your-firebase-project-id'
fcm.serviceAccountPath = 'writable/firebase-service-account.json'

#--------------------------------------------------------------------
# GOOGLE OAUTH (social login)
#--------------------------------------------------------------------
google.clientId     = 'your_google_oauth_client_id'
google.clientSecret = 'your_google_oauth_client_secret'
