{
  "info": {
    "name": "WERN Mobile API",
    "_postman_id": "wern-mobile-api-collection",
    "description": "All mobile (app-facing) endpoints for the WERN backend (CodeIgniter 4).\n\nSetup:\n1. Set the collection variable `base_url` (default https://www.wernapp.com/api).\n2. Run Auth > User Login (or Verify Registration) to get a JWT.\n3. Copy the returned `token` into the collection variable `token`.\n   (Most endpoints require `token`.)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://www.wernapp.com/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "User Registration",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"full_name\": \"John Doe\",\n  \"country_code\": \"+1\",\n  \"phone_number\": \"5551234567\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Secret@123\",\n  \"confirm_password\": \"Secret@123\",\n  \"refferal_code\": \"\"\n}" },
            "url": { "raw": "{{base_url}}/user-registration", "host": ["{{base_url}}"], "path": ["user-registration"] }
          }
        },
        {
          "name": "Verify Registration OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"email\": \"john@example.com\",\n  \"otp\": \"123456\"\n}" },
            "url": { "raw": "{{base_url}}/verify-registration-account", "host": ["{{base_url}}"], "path": ["verify-registration-account"] }
          }
        },
        {
          "name": "Resend Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"email\": \"john@example.com\"\n}" },
            "url": { "raw": "{{base_url}}/resend-verify-otp", "host": ["{{base_url}}"], "path": ["resend-verify-otp"] }
          }
        },
        {
          "name": "User Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Secret@123\",\n  \"device_id\": \"fcm-or-device-token\"\n}" },
            "url": { "raw": "{{base_url}}/user-login-action", "host": ["{{base_url}}"], "path": ["user-login-action"] }
          }
        },
        {
          "name": "Forgot Password - Send OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"email\": \"john@example.com\"\n}" },
            "url": { "raw": "{{base_url}}/forgot-password-send-otp", "host": ["{{base_url}}"], "path": ["forgot-password-send-otp"] }
          }
        },
        {
          "name": "Forgot Password - Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"email\": \"john@example.com\",\n  \"otp\": \"123456\"\n}" },
            "url": { "raw": "{{base_url}}/forgot-password-verify-otp", "host": ["{{base_url}}"], "path": ["forgot-password-verify-otp"] }
          }
        },
        {
          "name": "Forgot Password - Change",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"token\": \"{{token}}\",\n  \"password\": \"NewSecret@123\",\n  \"confirm_password\": \"NewSecret@123\"\n}" },
            "url": { "raw": "{{base_url}}/forgot-password-change", "host": ["{{base_url}}"], "path": ["forgot-password-change"] }
          }
        },
        {
          "name": "Change Password (logged in)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"token\": \"{{token}}\",\n  \"old_password\": \"Secret@123\",\n  \"new_password\": \"NewSecret@123\",\n  \"confirm_password\": \"NewSecret@123\"\n}" },
            "url": { "raw": "{{base_url}}/change-password-user", "host": ["{{base_url}}"], "path": ["change-password-user"] }
          }
        }
      ]
    },
    {
      "name": "User & Profile",
      "item": [
        {
          "name": "Get User Details",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/get-user-details?token={{token}}", "host": ["{{base_url}}"], "path": ["get-user-details"], "query": [{ "key": "token", "value": "{{token}}" }] } }
        },
        {
          "name": "Get Referral Users History",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/get-refferal-users-history?token={{token}}", "host": ["{{base_url}}"], "path": ["get-refferal-users-history"], "query": [{ "key": "token", "value": "{{token}}" }] } }
        },
        {
          "name": "Daily Claim",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/user-daily-claim?token={{token}}", "host": ["{{base_url}}"], "path": ["user-daily-claim"], "query": [{ "key": "token", "value": "{{token}}" }] } }
        },
        {
          "name": "Get Daily Claim Status",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/get-daily-claim-status?token={{token}}", "host": ["{{base_url}}"], "path": ["get-daily-claim-status"], "query": [{ "key": "token", "value": "{{token}}" }] } }
        },
        {
          "name": "Get Points Summary",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/get-points-summary?token={{token}}&category_id=", "host": ["{{base_url}}"], "path": ["get-points-summary"], "query": [{ "key": "token", "value": "{{token}}" }, { "key": "category_id", "value": "" }] } }
        },
        {
          "name": "User Activity",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/user-activity?token={{token}}", "host": ["{{base_url}}"], "path": ["user-activity"], "query": [{ "key": "token", "value": "{{token}}" }] } }
        },
        {
          "name": "Update User Image / Profile",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "formdata", "formdata": [
              { "key": "token", "value": "{{token}}", "type": "text" },
              { "key": "full_name", "value": "John Doe", "type": "text" },
              { "key": "nickname", "value": "Johnny", "type": "text" },
              { "key": "phone_number", "value": "5551234567", "type": "text" },
              { "key": "user_image", "type": "file", "src": [] }
            ] },
            "url": { "raw": "{{base_url}}/update-user-image", "host": ["{{base_url}}"], "path": ["update-user-image"] }
          }
        },
        {
          "name": "Get Weather By Location",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/get-weather-by-location?latitude=25.2&longitude=55.27&unit=C", "host": ["{{base_url}}"], "path": ["get-weather-by-location"], "query": [{ "key": "latitude", "value": "25.2" }, { "key": "longitude", "value": "55.27" }, { "key": "unit", "value": "C" }] } }
        },
        {
          "name": "Delete All Data (account deletion)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"gmail\": \"john@example.com\",\n  \"reason\": \"No longer using the app\"\n}" },
            "url": { "raw": "{{base_url}}/delete-all-data", "host": ["{{base_url}}"], "path": ["delete-all-data"] }
          }
        }
      ]
    },
    {
      "name": "Steps & Goals",
