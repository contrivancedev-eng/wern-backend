        },
        {
          "name": "Litties Transaction",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/get-littes-transection?token={{token}}", "host": ["{{base_url}}"], "path": ["get-littes-transection"], "query": [{ "key": "token", "value": "{{token}}" }] } }
