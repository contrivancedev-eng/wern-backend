          "name": "Get User Goals",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/get-user-goals?token={{token}}", "host": ["{{base_url}}"], "path": ["get-user-goals"], "query": [{ "key": "token", "value": "{{token}}" }] } }
        }
      ]
    },
