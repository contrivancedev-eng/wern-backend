          "name": "Save Step Event",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "token", "value": "{{token}}", "type": "text" },
              { "key": "category_id", "value": "0", "type": "text" },
              { "key": "steps", "value": "500", "type": "text" },
              { "key": "type", "value": "walk", "type": "text" },
              { "key": "timestamp", "value": "0", "type": "text" },
              { "key": "lat", "value": "", "type": "text" },
              { "key": "lng", "value": "", "type": "text" }
            ] },
            "url": { "raw": "{{base_url}}/save-step-event", "host": ["{{base_url}}"], "path": ["save-step-event"] }
          }
        },
        {
          "name": "Step Summary - Today",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/get-step-summary-today?token={{token}}&category_id=", "host": ["{{base_url}}"], "path": ["get-step-summary-today"], "query": [{ "key": "token", "value": "{{token}}" }, { "key": "category_id", "value": "" }] } }
